{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixico Studio",
  "version": "0.1.0",
  "identifier": "id.pixico.studio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Pixico Studio",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
